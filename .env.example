# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@bluepalmautocare.com
# 32+ random characters (openssl rand -base64 48). Required in production.
SESSION_SECRET=
# Where new-booking / new-application alerts go
ADMIN_NOTIFY_EMAIL=

# ---- Staff login (local mode only; ignored when Supabase is configured) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
DISPATCHER_EMAIL=
DISPATCHER_PASSWORD=

# ---- Supabase (database, staff auth, document storage) ----
# Leave blank to use the local JSON store in ./data (development only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (email) ----
RESEND_API_KEY=
EMAIL_FROM="BluePalm Auto Care <bookings@yourdomain.com>"

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Stripe Connect (payments & detailer payouts) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
